# Milevana Firebase web-app config (public values — safe to expose in the
# bundle; security comes from Firestore rules, not from hiding these).
# Copy to .env and fill in from the Firebase console → Project settings →
# Your web app. See docs/firebase-setup-runbook.md.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=milevana.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=milevana
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=milevana.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Android): the *web* OAuth client id from Google Cloud
# Console → Credentials. @react-native-google-signin exchanges its ID token
# for a Firebase credential; the same client later gains drive.file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local development only — point the web SDK at the Firestore emulator.
# Never set this in a build that ships.
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=
