rules_version = '2';

// Milevana Foundation rules (FND-SEC-01/02/03).
// Everything is denied by default and opened only as below.
// Decisions applied: docs/requirements.md "Decisions on open questions".
//  - Sharing (SHR-04/05, SD-01/03/05/06): invites are owner-written; a linked
//    user joins by marking an unused invite in the same write that adds their
//    member record; members leave themselves, owners remove others and owners
//    transfer ownership with a role swap.
//  - Timestamps must not be in the future, so merged and restored copies keep
//    their original dates.
//  - createdBy and updatedBy must equal the caller.
//  - Field caps mirror src/data/schema/* (name ≤ 60, plate ≤ 15, notes ≤ 500,
//    ≤ 5 attachments, ≤ 10 members, ≤ 50 template items, odometer ≤ 9,999,999.9).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function vehiclePath(vid) {
      return /databases/$(database)/documents/vehicles/$(vid);
    }

    function vehicleData(vid) {
      return get(vehiclePath(vid)).data;
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function inviteData(code) {
      return get(invitePath(code)).data;
    }

    // SD-03: joining requires a linked (non-anonymous) account. Anonymous
    // tokens carry firebase.sign_in_provider == 'anonymous'; older/emulated
    // tokens without the claim are treated as linked.
    function anonymous() {
      return request.auth.token.firebase is map
        && request.auth.token.firebase.keys().hasAny(['sign_in_provider'])
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function notInFuture(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function optShort(s) {
      return s is string && s.size() <= 60;
    }

    // ---------- users ----------
    // Only the owner of the document can touch it (FR-SEC-01).
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && uid() == userId;
    }

    // ---------- vehicles ----------
    function memberMapOk(d) {
      // members keys must equal memberIds, the owner must be a member with
      // role 'owner'. Membership changes come only through the Sharing write
      // paths below (join, leave, remove, transfer).
      return d.memberIds is list && d.memberIds.size() >= 1 && d.memberIds.size() <= 10
        && d.members is map
        && d.members.keys().toSet() == d.memberIds.toSet()
        && d.ownerId in d.memberIds
        && d.members[d.ownerId].role == 'owner'
        && notInFuture(d.members[d.ownerId].joinedAt);
    }

    function validVehicle(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.type in ['car', 'bike', 'scooter', 'truck', 'bus', 'other']
        && d.color is string && d.color.matches('^c(0[1-9]|1[0-2])$')
        && (!d.keys().hasAny(['make']) || optShort(d.make))
        && (!d.keys().hasAny(['model']) || optShort(d.model))
        && (!d.keys().hasAny(['year']) || (d.year is int && d.year >= 1950 && d.year <= 2100))
        && (!d.keys().hasAny(['plate']) || (d.plate is string && d.plate.size() <= 15))
        && d.fuelTypes is list && d.fuelTypes.size() >= 1 && d.fuelTypes.size() <= 5
        && d.fuelTypes.hasOnly(['petrol', 'diesel', 'cng', 'lpg', 'electric'])
        && d.odometerUnit in ['km', 'mi', 'hours']
        && d.currency is string && d.currency.matches('^[A-Z]{3}$')
        && d.startOdometer is number && d.startOdometer >= 0 && d.startOdometer <= 9999999.9
        && d.lastOdometer is number && d.lastOdometer >= 0
        && notInFuture(d.lastOdometerAt)
        && d.ownerId is string
        && memberMapOk(d)
        && d.archived is bool
        && notInFuture(d.createdAt) && notInFuture(d.updatedAt)
        && d.schemaVersion is int;
    }

    // Foundation: nobody may change ownership or membership fields, except the
    // DR-02 link-time profile fill below.
    function ownerKeepsMembership() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'memberIds', 'members']);
    }

    // DR-02: when an anonymous account links Google, the owner fills in their
    // own member record's name/email. Sole-member vehicles only (anonymous
    // accounts can never share), own record only, name/email keys only, and
    // role/joinedAt stay untouched.
    function ownerFillsMemberProfile() {
      return resource.data.ownerId == uid()
        && resource.data.memberIds == [uid()]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.members[uid()].diff(resource.data.members[uid()])
            .affectedKeys().hasOnly(['name', 'email'])
        && request.resource.data.members[uid()].role == 'owner'
        && request.resource.data.members[uid()].joinedAt == resource.data.members[uid()].joinedAt
        && (!request.resource.data.members[uid()].keys().hasAny(['name'])
            || optShort(request.resource.data.members[uid()].name))
        && (!request.resource.data.members[uid()].keys().hasAny(['email'])
            || (request.resource.data.members[uid()].email is string
                && request.resource.data.members[uid()].email.size() <= 320));
    }

    // Members may update only lastOdometer, lastOdometerAt and updatedAt.
    function memberOdometerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastOdometer', 'lastOdometerAt', 'updatedAt'])
        && request.resource.data.lastOdometer is number
        && request.resource.data.lastOdometer >= 0
        && notInFuture(request.resource.data.lastOdometerAt)
        && notInFuture(request.resource.data.updatedAt);
    }

    // SHR-04/SD-03: the joiner adds exactly their own uid to memberIds and a
    // matching member record (name + email + joinedAt + inviteCode) to members,
    // while the same batch marks the invite used. They cannot read the vehicle
    // before joining, so the invite does the validation: it must exist, be
    // unused, unexpired and point at THIS vehicle, and its post-write state
    // must record the joiner (getAfter). The vehicle must not be archived and
    // must stay under the 10-member cap.
    function joinsWithInvite(vid) {
      let post = request.resource.data;
      let newIds = post.memberIds.toSet().difference(resource.data.memberIds.toSet());
      return post.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
        && !resource.data.archived
        && newIds.size() == 1
        && newIds.hasAny([uid()])
        && post.memberIds.size() == resource.data.memberIds.size() + 1
        && post.memberIds.size() <= 10
        && !resource.data.members.keys().hasAny([uid()])
        && post.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
        && post.members[uid()].role == 'member'
        && post.members[uid()].name is string
        && post.members[uid()].name.size() >= 1
        && post.members[uid()].name.size() <= 60
        && post.members[uid()].email is string
        && post.members[uid()].email.size() >= 1
        && post.members[uid()].email.size() <= 320
        && notInFuture(post.members[uid()].joinedAt)
        && post.members[uid()].inviteCode is string
        && post.members[uid()].inviteCode.size() >= 1
        && post.members[uid()].inviteCode.size() <= 16
        && !anonymous()
        && exists(invitePath(post.members[uid()].inviteCode))
        && !inviteData(post.members[uid()].inviteCode).keys().hasAny(['usedBy'])
        && inviteData(post.members[uid()].inviteCode).vehicleId == vid
        && inviteData(post.members[uid()].inviteCode).expiresAt > request.time
        && getAfter(invitePath(post.members[uid()].inviteCode)).data.keys().hasAny(['usedBy'])
        && getAfter(invitePath(post.members[uid()].inviteCode)).data.usedBy == uid()
        && notInFuture(getAfter(invitePath(post.members[uid()].inviteCode)).data.usedAt)
        && validVehicle(post);
    }

    // SHR-05/SD-06/07: a member removes exactly their own uid from memberIds
    // and members. The owner cannot leave — they must transfer or delete.
    function memberLeaves() {
      let post = request.resource.data;
      let gone = resource.data.memberIds.toSet().difference(post.memberIds.toSet());
      return resource.data.ownerId != uid()
        && post.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
        && gone.size() == 1
        && gone.hasAny([uid()])
        && post.memberIds.size() == resource.data.memberIds.size() - 1
        && post.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
        && !post.members.keys().hasAny([uid()])
        && validVehicle(post);
    }

    // SHR-05/SD-06/07: the owner removes exactly one other member — never
    // themselves and never more than one uid at a time.
    function ownerRemovesMember() {
      let post = request.resource.data;
      let gone = resource.data.memberIds.toSet().difference(post.memberIds.toSet());
      return resource.data.ownerId == uid()
        && post.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
        && gone.size() == 1
        && !gone.hasAny([uid()])
        && post.memberIds.size() == resource.data.memberIds.size() - 1
        // memberMapOk keeps members keys == memberIds, so the post map cannot
        // retain the removed uid; the diff must touch exactly that one key.
        && post.members.diff(resource.data.members).affectedKeys() == gone
        && validVehicle(post);
    }

    // SHR-05/SD-06/07: ownership moves to an existing member in one write —
    // ownerId flips and exactly the two member records swap roles; memberIds
    // and every other member record are untouched.
    function ownerTransfers() {
      let post = request.resource.data;
      return resource.data.ownerId == uid()
        && post.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'members', 'updatedAt'])
        && post.ownerId in resource.data.memberIds
        && post.ownerId != uid()
        && post.members.diff(resource.data.members).affectedKeys()
            .hasAll([uid(), post.ownerId])
        && post.members.diff(resource.data.members).affectedKeys()
            .hasOnly([uid(), post.ownerId])
        && post.members[uid()].role == 'member'
        && post.members[post.ownerId].role == 'owner'
        && post.members[uid()].diff(resource.data.members[uid()])
            .affectedKeys().hasOnly(['role'])
        && post.members[post.ownerId].diff(resource.data.members[post.ownerId])
            .affectedKeys().hasOnly(['role'])
        && validVehicle(post);
    }

    match /vehicles/{vid} {
      allow read: if signedIn() && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && validVehicle(request.resource.data);

      allow update: if signedIn() && (
        (resource.data.ownerId == uid()
          && ownerKeepsMembership()
          && validVehicle(request.resource.data))
        || (uid() in resource.data.memberIds && memberOdometerUpdate())
        || (ownerFillsMemberProfile() && validVehicle(request.resource.data))
        || memberLeaves()
        || ownerRemovesMember()
        || ownerTransfers()
        || joinsWithInvite(vid)
      );

      allow delete: if signedIn() && resource.data.ownerId == uid();

      // ---------- entries ----------
      function attachmentOk(a) {
        return a is map
          && a.id is string && a.id.size() > 0
          && a.ownerUid is string && a.ownerUid.size() > 0
          && a.mimeType is string && a.mimeType.size() > 0 && a.mimeType.size() <= 120
          && a.sizeBytes is int && a.sizeBytes >= 0
          && a.status in ['queued', 'uploading', 'uploaded', 'failed', 'missing']
          && a.sharedWithUids is list && a.sharedWithUids.size() <= 10;
      }

      function hasCategory(t) {
        return t in ['expense', 'service', 'income'];
      }

      function amountOk(d, vehicleCurrency) {
        return d.type in ['fuel', 'expense', 'service', 'income']
          ? (d.keys().hasAny(['amount'])
              && d.amount.minor is int
              && (d.type == 'service' ? d.amount.minor >= 0 : d.amount.minor > 0)
              && d.amount.currency == vehicleCurrency)
          : !d.keys().hasAny(['amount']);
      }

      function validEntry(d, vehicleCurrency) {
        return d.type in ['fuel', 'expense', 'service', 'income', 'trip', 'inspection']
          // LD-04: a future entry DATE is allowed (with a client-side note);
          // only the audit timestamps are checked against the future.
          && d.date is timestamp
          && notInFuture(d.createdAt) && notInFuture(d.updatedAt)
          && (!d.keys().hasAny(['odometer']) || (d.odometer is number && d.odometer >= 0))
          && amountOk(d, vehicleCurrency)
          && (hasCategory(d.type)
              ? (d.keys().hasAny(['category']) && d.category is string && d.category.size() > 0 && d.category.size() <= 60)
              : !d.keys().hasAny(['category']))
          && (!d.keys().hasAny(['notes']) || (d.notes is string && d.notes.size() <= 500))
          && d.attachments is list && d.attachments.size() <= 5
          && validAttachments(d)
          && d.uploaderUids is list && d.uploaderUids.size() <= 10
          && d.createdBy is string && d.createdBy.size() > 0
          && d.createdByName is string && d.createdByName.size() > 0 && d.createdByName.size() <= 60
          && d.updatedBy is string && d.updatedBy.size() > 0
          && d.schemaVersion is int
          && (d.type in ['fuel', 'service', 'trip', 'inspection']
              ? (d.keys().hasAny(['details']) && d.details is map)
              : true);
      }

      function validAttachments(d) {
        return d.attachments.size() == 0
          || (d.attachments.size() <= 5
              && attachmentListOk(d.attachments));
      }

      // Rules have no list comprehension; check each slot individually.
      function attachmentListOk(list) {
        return (list.size() < 1 || attachmentOk(list[0]))
          && (list.size() < 2 || attachmentOk(list[1]))
          && (list.size() < 3 || attachmentOk(list[2]))
          && (list.size() < 4 || attachmentOk(list[3]))
          && (list.size() < 5 || attachmentOk(list[4]));
      }

      match /entries/{eid} {
        allow read: if signedIn() && uid() in vehicleData(vid).memberIds;

        allow create: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && request.resource.data.createdBy == uid()
          && request.resource.data.updatedBy == uid()
          && validEntry(request.resource.data, vehicleData(vid).currency);

        allow update: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && (resource.data.createdBy == uid() || vehicleData(vid).ownerId == uid())
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.createdByName == resource.data.createdByName
              // DR-02: linking rewrites the caller's own 'Me' placeholder to
              // their Google display name. Nothing else may touch the field.
              || (resource.data.createdBy == uid() && resource.data.createdByName == 'Me'))
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == uid()
          && validEntry(request.resource.data, vehicleData(vid).currency);

        allow delete: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && (resource.data.createdBy == uid() || vehicleData(vid).ownerId == uid());
      }

      // ---------- reminders ----------
      function validReminder(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.subject is map && d.subject.kind in ['service', 'expense', 'custom']
          && (!d.subject.keys().hasAny(['serviceType']) || optShort(d.subject.serviceType))
          && (!d.subject.keys().hasAny(['category']) || optShort(d.subject.category))
          && (d.subject.kind != 'service' || d.subject.serviceType is string)
          && (d.subject.kind != 'expense' || d.subject.category is string)
          && (d.keys().hasAny(['dateTrigger']) || d.keys().hasAny(['odometerTrigger']))
          // A due date is meant to be in the future, so it is only type-checked.
          && (!d.keys().hasAny(['dateTrigger'])
              || (d.dateTrigger is map && d.dateTrigger.dueDate is timestamp))
          && (!d.keys().hasAny(['odometerTrigger'])
              || (d.odometerTrigger is map
                  && d.odometerTrigger.dueOdometer is number && d.odometerTrigger.dueOdometer >= 0))
          && d.leadDays is int && d.leadDays >= 0
          && d.leadDistance is number && d.leadDistance >= 0
          && (!d.keys().hasAny(['amountMinor']) || (d.amountMinor is int && d.amountMinor >= 0))
          && d.status in ['active', 'done']
          && (!d.keys().hasAny(['completedAt']) || notInFuture(d.completedAt))
          && d.createdBy is string && d.createdBy.size() > 0
          && notInFuture(d.createdAt) && notInFuture(d.updatedAt)
          && d.schemaVersion is int;
      }

      match /reminders/{rid} {
        allow read, delete: if signedIn() && uid() in vehicleData(vid).memberIds;

        allow create: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && request.resource.data.createdBy == uid()
          && validReminder(request.resource.data);

        allow update: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && request.resource.data.createdBy == resource.data.createdBy
          && validReminder(request.resource.data);
      }

      // ---------- checklist templates ----------
      function templateItemOk(i) {
        return i is map
          && i.id is string && i.id.size() > 0 && i.id.size() <= 60
          && i.label is string && i.label.size() > 0 && i.label.size() <= 60;
      }

      function validTemplate(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.items is list && d.items.size() <= 50
          && d.createdBy is string && d.createdBy.size() > 0
          && notInFuture(d.createdAt) && notInFuture(d.updatedAt)
          && d.schemaVersion is int;
      }

      match /checklistTemplates/{tid} {
        allow read: if signedIn() && uid() in vehicleData(vid).memberIds;

        allow create: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && request.resource.data.createdBy == uid()
          && validTemplate(request.resource.data);

        allow update: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && request.resource.data.createdBy == resource.data.createdBy
          && validTemplate(request.resource.data);

        allow delete: if signedIn()
          && uid() in vehicleData(vid).memberIds
          && (resource.data.createdBy == uid() || vehicleData(vid).ownerId == uid());
      }
    }

    // ---------- invites (SHR-04, SD-01/03/05) ----------
    match /invites/{code} {
      // SD-01: any signed-in user (anonymous included) may GET an invite by
      // its exact code so the join screen can show names before linking —
      // provided the vehicle still exists; a deleted vehicle's invite reads
      // fail so the join screen can say "This vehicle no longer exists".
      // Listing is owner-only — a query that touches another owner's invites
      // is denied, so codes cannot be enumerated.
      allow get: if signedIn()
        && (resource == null
            || (resource.data.vehicleId is string
                && exists(vehiclePath(resource.data.vehicleId))));
      allow list: if signedIn() && resource.data.ownerId == uid();

      // Only the vehicle's owner mints invites. The code is the document id
      // (8 chars, checked by the app), expires exactly 7 days after creation
      // and is single-use. Codes cannot be overwritten (set() on an existing
      // doc is an update, not a create).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
            'vehicleId', 'vehicleName', 'ownerId', 'ownerName',
            'createdBy', 'createdAt', 'expiresAt', 'schemaVersion'])
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId.size() > 0
        && request.resource.data.vehicleName is string
        && request.resource.data.vehicleName.size() >= 1
        && request.resource.data.vehicleName.size() <= 60
        && request.resource.data.ownerId == uid()
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 60
        && request.resource.data.createdBy == uid()
        && notInFuture(request.resource.data.createdAt)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt
            == request.resource.data.createdAt + duration.value(7, 'd')
        && (!request.resource.data.keys().hasAny(['schemaVersion'])
            || request.resource.data.schemaVersion is int)
        && exists(vehiclePath(request.resource.data.vehicleId))
        && vehicleData(request.resource.data.vehicleId).ownerId == uid()
        && !vehicleData(request.resource.data.vehicleId).archived;

      // Two update shapes: (a) the join mark — an unused, unexpired invite
      // gains exactly usedBy/usedAt, and the same write adds the caller to
      // the invite's vehicle with inviteCode == this code (prevents replay
      // and binds both writes together — SD-02/03/06); joining needs a
      // linked account and the vehicle must exist and not be archived.
      // (b) the owner mirrors the vehicle's archived flag onto the invite so
      // a joiner sees "vehicle archived" — they cannot read the vehicle.
      allow update: if signedIn()
        && ((!anonymous()
            && !resource.data.keys().hasAny(['usedBy', 'usedAt'])
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == uid()
            && request.resource.data.usedAt is timestamp
            && notInFuture(request.resource.data.usedAt)
            && exists(vehiclePath(resource.data.vehicleId))
            && !vehicleData(resource.data.vehicleId).archived
            && getAfter(vehiclePath(resource.data.vehicleId)).data.memberIds.hasAny([uid()])
            && getAfter(vehiclePath(resource.data.vehicleId)).data.members[uid()].role == 'member'
            && getAfter(vehiclePath(resource.data.vehicleId)).data.members[uid()].inviteCode == code)
          || (resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vehicleArchived'])
            && request.resource.data.vehicleArchived is bool));

      // The owner cancels a pending invite by deleting it (SHR-04 #9).
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }
  }
}
